# Production-ready defaults for Docker/Kubernetes deployments
# Copy to `.env` (or reference via env_file) and update secrets before running.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Secrets
OPENROUTER_API_KEY=replace-me
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=https://your-domain.example
OPENROUTER_X_TITLE=SimpleSpecs

# Persistent storage paths (inside the container)
DATABASE_URL=sqlite:////data/db/simplespecs.db
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports
EXPORT_RETENTION_DAYS=30

# Upload limits and parsing behaviour
MAX_UPLOAD_SIZE=26214400
ALLOWED_MIMETYPES=application/pdf
PARSER_MULTI_COLUMN=true
PARSER_ENABLE_OCR=true
MINERU_FALLBACK=true
HEADERS_MODE=llm_simple
# LLM model & timeouts
HEADERS_LLM_MODEL=anthropic/claude-3.5-sonnet
HEADERS_LLM_MODEL_FALLBACK=openai/gpt-4.1-mini
HEADERS_LLM_TIMEOUT_S=240
HEADERS_LLM_MAX_INPUT_TOKENS=80000
HEADERS_LLM_CACHE_DIR=.cache/headers
# Chunking & retries
HEADERS_LLM_CHUNKING=auto     # off|auto|force
HEADERS_LLM_CHUNK_TARGET_TOKENS=35000
HEADERS_LLM_RETRY_MAX=4
HEADERS_LLM_BACKOFF_S=2
# Alignment defaults
HEADERS_ALIGN_STRATEGY=sequential
HEADERS_SUPPRESS_TOC=1
HEADERS_SUPPRESS_RUNNING=1
HEADERS_NORMALIZE_CONFUSABLES=1
HEADERS_STRICT_INVARIANTS=1
HEADERS_TITLE_ONLY_REANCHOR=1
HEADERS_LLM_STRICT=0
HEADERS_LOG_DIR=backend/logs

# Specification extraction defaults
SPEC_TERMS_DIR=backend/resources/terms
SPEC_RULE_MIN_HITS=1
SPEC_MULTI_LABEL_MARGIN=0.0
RISK_BASELINES_PATH=backend/resources/baselines/mandatory_clauses.json
